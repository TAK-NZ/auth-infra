# The brace-expansion DoS advisories (GHSA-q2hr-2g5m-vwhr, GHSA-qhr7-859c-m2p7,
# GHSA-6j4f-fj2g-mc7p) that affected the copy bundled inside aws-cdk-lib's
# minimatch dependency were resolved by aws-cdk-lib 2.273.0 (bundles
# brace-expansion 5.0.12). npm overrides do not apply to bundled dependencies,
# so re-check `npm audit` on every aws-cdk-lib upgrade. The `brace-expansion`
# override in package.json remains for non-bundled copies.
audit-level=critical
